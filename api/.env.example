# =====================================================================
# Absensi Face Recognition API (Rust / Axum)
# Dinas Pendidikan Provinsi Sumatera Utara
#
# Salin ke `.env` lalu sesuaikan. Nilai yang WAJIB diisi ditandai (WAJIB).
# =====================================================================

APP_NAME="Jargon GO API"
APP_ENV=local            # local | staging | production
BIND_ADDR=0.0.0.0:8080
PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------------
# PostgreSQL (WAJIB)
#
# Wajib PostgreSQL 15+ dengan ekstensi `vector` (pgvector). Ekstensi lain
# yang dipakai: pgcrypto, pg_trgm, btree_gin, unaccent.
#
# Database ini juga dipakai dashboard Laravel di ../admin. Skema dimiliki
# oleh migrasi sqlx di ./migrations — JANGAN jalankan `php artisan migrate`.
# ---------------------------------------------------------------------
DATABASE_URL=postgres://absensi:absensi@localhost:5432/absensi

# Ukuran pool. Jam sibuk absensi (06:30-07:15) adalah beban puncak sistem:
# ribuan tablet memanggil /v1/kiosk/recognize nyaris bersamaan.
DB_MAX_CONNECTIONS=32
DB_MIN_CONNECTIONS=4
DB_ACQUIRE_TIMEOUT_SECS=10

# Batas waktu per statement. Mencegah satu query lambat menahan koneksi
# selamanya dan membuat seluruh gerbang absensi menggantung.
DB_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------
# Redis (opsional, sangat dianjurkan di produksi)
#
# Dipakai untuk rate limit dan proteksi replay nonce. Tanpa Redis, API tetap
# berjalan tetapi kedua proteksi itu tidak aktif (fail-open — membatasi
# absensi siswa dianggap lebih buruk daripada kehilangan rate limit).
# ---------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/2

# ---------------------------------------------------------------------
# Autentikasi (WAJIB)
#
# JWT_SECRET minimal 32 karakter acak. Hasilkan dengan:
#   openssl rand -base64 48
# ---------------------------------------------------------------------
JWT_SECRET=GANTI-INI-dengan-string-acak-minimal-32-karakter
JWT_ISSUER=jargon-api

ACCESS_TOKEN_TTL_SECS=3600        # 1 jam
REFRESH_TOKEN_TTL_SECS=2592000    # 30 hari

# Kunci AES-256-GCM (32 byte hex) untuk mengenkripsi kredensial provider
# notifikasi yang tersimpan di kolom JSONB. Hasilkan dengan:
#   openssl rand -hex 32
SECRETS_KEY_HEX=

# ---------------------------------------------------------------------
# Penyimpanan berkas
#
# Berisi foto pendaftaran wajah (~60 KB x 3 sampel x jumlah siswa).
# Estimasi kapasitas provinsi: 700.000 x 3 x 60 KB ≈ 126 GB.
#
# Di produksi arahkan STORAGE_ROOT ke volume bersama atau mount
# S3-compatible (MinIO) agar semua replika API melihat berkas yang sama.
# ---------------------------------------------------------------------
STORAGE_ROOT=./storage
STORAGE_PUBLIC_BASE=/files
MAX_UPLOAD_BYTES=8388608          # 8 MB

# ---------------------------------------------------------------------
# Pengenalan wajah
#
# FACE_MODEL_VERSION dan FACE_EMBEDDING_DIM HARUS sama dengan nilai pada
# aplikasi Flutter (--dart-define) dan pada model TFLite yang dipakai.
# Embedding lintas versi model tidak sebanding — mencocokkannya menghasilkan
# identifikasi ACAK, bukan sekadar akurasi lebih rendah.
# ---------------------------------------------------------------------
FACE_EMBEDDING_DIM=512
FACE_MODEL_VERSION=mobilefacenet-v1

# Ambang cosine similarity minimum untuk menerima kecocokan (0..1).
# Terlalu rendah: orang lain bisa dikenali sebagai siswa.
# Terlalu tinggi: siswa yang sah gagal absen.
# 0.62 adalah titik awal yang wajar untuk MobileFaceNet; ukur di lapangan
# sebelum mengubahnya, dan gunakan override per sekolah bila perlu
# (kolom schools.face_match_threshold).
FACE_MATCH_THRESHOLD=0.62

# Selisih minimum antara kandidat terbaik dan siswa lain terdekat. Melindungi
# kasus saudara kembar: skor tinggi tetapi ambigu lebih baik ditolak daripada
# mencatat kehadiran orang yang salah.
FACE_MATCH_MARGIN=0.04

FACE_MIN_LIVENESS=0.5
FACE_MIN_ENROLL_QUALITY=0.45

# Berapa lama cache vektor per sekolah dianggap segar (detik).
FACE_INDEX_TTL_SECS=300

# Toleransi selisih jam tablet vs server (detik). Payload di luar jendela ini
# ditolak sebagai kemungkinan replay.
FACE_CLOCK_SKEW_SECS=120

FACE_SCAN_COOLDOWN_SECS=60

# ---------------------------------------------------------------------
# Notifikasi wali murid
# ---------------------------------------------------------------------
NOTIFY_ENABLED=true
NOTIFY_BATCH_SIZE=100
NOTIFY_INTERVAL_SECS=5

# --- WhatsApp ---
# fonnte / wablas  : provider lokal, murah, cocok untuk pilot.
# meta_cloud       : WhatsApp Cloud API resmi, wajib untuk skala provinsi.
WA_PROVIDER=fonnte
WA_TOKEN=
WA_BASE_URL=
WA_PHONE_NUMBER_ID=               # hanya untuk meta_cloud

# --- Telegram ---
# Kanal paling murah (gratis). Wali murid harus menekan /start pada bot
# sekolah lebih dulu agar chat_id-nya diketahui.
TELEGRAM_BOT_TOKEN=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@disdik.sumutprov.go.id
SMTP_FROM_NAME="Absensi Disdik Sumut"
SMTP_STARTTLS=true

# ---------------------------------------------------------------------
# Keamanan & operasional
# ---------------------------------------------------------------------
# Origin yang boleh memanggil API dari browser, dipisah koma.
#
# Ini berlaku untuk DUA hal: dashboard /admin, dan aplikasi Jargon GO yang
# dijalankan sebagai web saat debug (`jargon-fe/run-web.bat`, port 5000).
# Aplikasi Android/iOS tidak terpengaruh — CORS adalah aturan browser.
#
# `*` cukup untuk lokal. Di produksi ganti dengan domain sebenarnya, mis:
#   CORS_ALLOWED_ORIGINS=https://absensi.disdik.sumutprov.go.id
#
# Untuk debug web sambil membatasi origin:
#   CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:5000
#
# `127.0.0.1` dan `localhost` adalah ORIGIN YANG BERBEDA bagi browser,
# walau menunjuk mesin yang sama. Cantumkan bentuk yang benar-benar dipakai
# di address bar — atau cantumkan keduanya.
CORS_ALLOWED_ORIGINS=*

# Matikan di produksi bila dokumentasi API tidak perlu terbuka publik.
ENABLE_SWAGGER=true

TRUSTED_PROXY=false

# Setel false pada replika yang hanya melayani HTTP, bila worker
# (notifikasi & pemeliharaan harian) dijalankan pada replika terpisah.
WORKERS_ENABLED=true

# Level log: jargon_api=debug untuk pengembangan.
RUST_LOG=jargon_api=info,tower_http=info,sqlx=warn
