# =====================================================================
# Dashboard /admin — Absensi Face Recognition
# Dinas Pendidikan Provinsi Sumatera Utara
# =====================================================================

APP_NAME="Absensi Disdik Sumut"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# WIB. Seluruh Sumatera Utara UTC+7 dan tidak ada DST, jadi nilai ini tetap.
# HARUS sama dengan timezone yang dipakai API Rust, kalau tidak jam masuk
# yang ditampilkan dashboard akan bergeser 7 jam dari yang tercatat.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Database — PostgreSQL (BERSAMA dengan API Rust)
#
# PENTING: skema dimiliki oleh migrasi sqlx di jargon-be/api/migrations.
# JANGAN jalankan `php artisan migrate`; migrasi Laravel sudah ditandai
# selesai oleh migrasi 0010_seed.sql agar tidak ada dua sumber kebenaran.
# ---------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=absensi
DB_USERNAME=absensi
DB_PASSWORD=absensi
DB_SCHEMA=public
DB_SSLMODE=prefer

# ---------------------------------------------------------------------
# Session / Cache / Queue — Redis
#
# Octane menjalankan aplikasi sebagai proses yang persisten, sehingga session
# & cache TIDAK boleh memakai driver `file` (tiap worker punya state sendiri)
# maupun `database` (menambah beban ke Postgres yang sudah melayani absensi).
# ---------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ---------------------------------------------------------------------
# Laravel Octane
# ---------------------------------------------------------------------
OCTANE_SERVER=roadrunner
OCTANE_HTTPS=false
# Jumlah worker; sesuaikan dengan jumlah core server.
OCTANE_WORKERS=4
OCTANE_MAX_REQUESTS=500

# ---------------------------------------------------------------------
# API Absensi (layanan Rust di jargon-be/api)
#
# ABSENSI_API_URL       : dipanggil dashboard dari sisi SERVER
#                         (boleh alamat internal container).
# ABSENSI_API_PUBLIC_URL: dipakai untuk tautan yang dibuka BROWSER pengguna,
#                         mis. foto pendaftaran wajah di /files/*.
#
# KEY_ID/SECRET berasal dari tabel `api_clients`; lihat docs/DEPLOYMENT.md
# untuk cara membuatnya.
# ---------------------------------------------------------------------
ABSENSI_API_URL=http://127.0.0.1:8080
ABSENSI_API_PUBLIC_URL=http://localhost:8080
ABSENSI_API_KEY_ID=
ABSENSI_API_SECRET=
ABSENSI_API_TIMEOUT=20

# Versi & dimensi model embedding. HARUS identik dengan nilai di API dan di
# model pada perangkat — embedding lintas versi tidak sebanding.
FACE_EMBEDDING_DIM=512
FACE_MODEL_VERSION=mobilefacenet-v1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@disdik.sumutprov.go.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
