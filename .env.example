# =====================================================================
# Jargon GO — konfigurasi container
#
# JANGAN mengisi berkas ini. Jalankan salah satu:
#
#     setup.bat        (Windows)
#     ./setup.sh       (Linux/macOS)
#
# Skrip itu menyalin berkas ini menjadi .env dan mengisi rahasianya
# dengan nilai acak. Nilai yang sudah Anda isi tidak pernah ditimpa.
#
# .env TIDAK boleh ikut dibagikan bersama repositori: isinya kunci yang
# menentukan siapa boleh masuk ke pemasangan Anda.
# =====================================================================

# ---------------------------------------------------------------------
# Rahasia — WAJIB, diisi otomatis oleh setup
# ---------------------------------------------------------------------

# Menandatangani token akses. Yang bisa ditebak berarti siapa pun dapat
# menempa token untuk peran apa pun, termasuk superadmin.
JWT_SECRET=

# Mengenkripsi kredensial provider notifikasi di database.
# Tepat 32 byte heksadesimal (64 karakter) — panjangnya ditentukan
# algoritmanya, bukan pilihan bebas.
SECRETS_KEY_HEX=

# Mengenkripsi cookie sesi dashboard. Bila kosong, container membuatkan
# kunci sementara saat start — akibatnya sesi login hilang setiap kali
# container dibangun ulang.
APP_KEY=

# Kata sandi PostgreSQL di dalam container.
POSTGRES_PASSWORD=absensi

# ---------------------------------------------------------------------
# Alamat
# ---------------------------------------------------------------------

# Port host untuk seluruh sistem. Semua dilayani nginx di satu port ini:
#   /          aplikasi Jargon GO
#   /admin     dashboard
#   /v1 /docs  API + Swagger
HTTP_PORT=80

# Alamat yang dibuka pengguna. Dipakai untuk tautan yang dihasilkan
# server (mis. URL berkas di dashboard).
#
# Aplikasi Jargon GO TIDAK memakai nilai ini: ia mengambil alamat API
# dari origin halamannya sendiri, sehingga tetap benar walau dibuka lewat
# IP LAN atau nama domain yang berbeda.
PUBLIC_URL=http://localhost

# Port host PostgreSQL. Ubah bila mesin Anda sudah punya PostgreSQL
# sendiri di 5432 — misalnya 55432 — supaya keduanya bisa berdampingan.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------
# Perilaku aplikasi
# ---------------------------------------------------------------------

APP_ENV=local
APP_DEBUG=false

# Matikan bila dokumentasi API tidak perlu terbuka.
ENABLE_SWAGGER=true

# Aplikasi web dan API berada di origin yang sama, jadi CORS tidak
# berperan. Nilai ini hanya penting bila ada klien lain dari domain lain.
CORS_ALLOWED_ORIGINS=*

RUST_LOG=jargon_api=info,tower_http=info,sqlx=warn

# ---------------------------------------------------------------------
# Pengenalan wajah
#
# FACE_MODEL_VERSION dan FACE_EMBEDDING_DIM HARUS sama dengan yang
# dipakai aplikasi tablet. Embedding dari model berbeda tidak sebanding —
# mencocokkannya menghasilkan identifikasi ACAK, bukan sekadar akurasi
# yang lebih rendah. Karena itu server menolak versi yang tidak cocok.
# ---------------------------------------------------------------------

FACE_MODEL_VERSION=mobilefacenet-v1
FACE_EMBEDDING_DIM=512
FACE_MATCH_THRESHOLD=0.62

# ---------------------------------------------------------------------
# Notifikasi wali murid — mati secara bawaan
#
# Dibiarkan mati supaya pemasangan percobaan tidak mengirim pesan sungguhan
# ke nomor orang tua yang ada di data contoh.
# ---------------------------------------------------------------------

NOTIFY_ENABLED=false
WA_PROVIDER=fonnte
WA_TOKEN=
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587

# ---------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------

# Disematkan, bukan `stable`, agar image yang dibangun bulan depan
# menghasilkan bundel yang sama.
#
# Harus berupa tag yang ADA di ghcr.io/cirruslabs/flutter — registry itu
# hanya memuat rilis minor (3.44.0), bukan setiap patch. Mesin pengembang
# boleh memakai patch yang lebih baru.
FLUTTER_VERSION=3.44.0

# `debug` mempercepat build web tetapi menghasilkan bundel jauh lebih besar.
WEB_BUILD_MODE=release

# ---------------------------------------------------------------------
# Image siap pakai (docker-compose.prod.yml)
#
# Dipakai saat menjalankan tanpa membangun dari sumber - lihat komentar di
# docker-compose.prod.yml.
#
# Di produksi pakai tag versi, bukan `latest`: `latest` membuat
# `docker compose pull` mengubah versi yang berjalan tanpa jejak apa pun
# tentang apa yang berubah.
# ---------------------------------------------------------------------
REGISTRY=ghcr.io/rendyirawann
IMAGE_TAG=latest
